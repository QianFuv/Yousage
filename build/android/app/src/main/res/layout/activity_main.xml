<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_layout"
    android:background="@color/wails_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.wails.app.StartupView
            android:id="@+id/startup_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <Button
            android:id="@+id/diagnostics_open"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="96dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:elevation="0dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:stateListAnimator="@null"
            android:text="@string/diagnostics_open"
            android:textAllCaps="false"
            android:textColor="#A3A3A3"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/viewer_recovery"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/wails_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:text="@string/viewer_load_failed"
                android:textColor="@android:color/white"
                android:textSize="18sp" />

            <Button
                android:id="@+id/viewer_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="48dp"
                android:text="@string/viewer_retry" />

            <Button
                android:id="@+id/viewer_diagnostics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/viewer_diagnostics" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
