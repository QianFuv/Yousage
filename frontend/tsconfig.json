{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "rootDirs": [
      "../tools/parity/upstream/apps/web/src/rpc",
      "../tools/parity/upstream/apps/web/src/state",
      "../tools/parity/src/bridges"
    ],
    "types": ["vite/client", "vitest/globals"],
    "paths": {
      "@reference": ["./src/reference.d.ts"],
      "@t3tools/shared/*": ["../tools/parity/upstream/packages/shared/src/*"],
      "@t3tools/contracts": ["./src/usage/contracts.tsx"],
"@t3tools/client-runtime/state/provider-instance-display": ["../tools/parity/src/bridges/instance.tsx"],
      "~/components/MorphIcon": [
        "../tools/parity/upstream/apps/web/src/components/MorphIcon.tsx"
      ],
      "~/lib/color": ["../tools/parity/upstream/apps/web/src/lib/color.ts"],
      "~/lib/observeResize": [
        "../tools/parity/upstream/apps/web/src/lib/observeResize.ts"
      ],
      "~/lib/visibleAnimation": [
        "../tools/parity/upstream/apps/web/src/lib/visibleAnimation.ts"
      ],
      "~/lib/windowControlsOverlay": [
        "../tools/parity/src/bridges/titlebar.tsx"
      ],
      "~/lib/utils": ["../tools/parity/src/bridges/utils.tsx"],
      "~/components/ui/*": [
        "../tools/parity/upstream/apps/web/src/components/ui/*"
      ],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom/index.d.ts"]
    }
  },
  "include": ["src"]
}
