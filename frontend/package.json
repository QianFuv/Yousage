{
  "name": "yousage-desktop",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "node ../tools/parity/node_modules/vite/dist/vite/node/cli.js --host 127.0.0.1 --port 4175 --strictPort",
    "build": "node ../tools/parity/node_modules/vite/dist/vite/node/cli.js build",
    "build:web": "node ../tools/parity/node_modules/vite/dist/vite/node/cli.js build --config vite.web.config.ts",
    "build:android": "node ../tools/parity/node_modules/vite/dist/vite/node/cli.js build --config vite.android.config.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js src reference-adapter.tsx vite.config.ts vite.web.config.ts vite.android.config.ts",
    "format:check": "prettier --check src reference-adapter.tsx vite.config.ts vite.web.config.ts vite.android.config.ts eslint.config.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "@noble/hashes": "2.2.0",
    "@wailsio/runtime": "3.0.0-beta.30",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "culori": "4.0.2",
    "effect": "4.0.2",
    "jsonc-parser": "3.3.1",
    "jszip": "3.10.1",
    "lucide": "0.564.0",
    "lucide-react": "0.564.0",
    "morphicons": "1.7.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/culori": "4.0.1",
    "@types/node": "24.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.1"
  }
}
